{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nn",
  // Custom entry: OpenNext's fetch handler plus the scheduled handler (worker.js).
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Hourly: expire 24-hour holds, send balance reminders, refresh FX rates.
  "triggers": { "crons": ["7 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nautical-nomads",
      // D1 "nautical-nomads", Western Europe (created 23 October 2026).
      "database_id": "5371c64f-2133-4f27-acc1-82438f8468fd",
      "migrations_dir": "migrations"
    }
  ],
  // Photos we host ourselves (Pixabay downloads, owner uploads). Create the
  // bucket once: Cloudflare → R2 → Create bucket → "nautical-nomads-photos",
  // location Europe. Served by the Worker at /media/<key>.
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "nautical-nomads-photos", "jurisdiction": "eu" }],
  "observability": { "enabled": true },
  "vars": {
    "SITE_URL": "https://nauticalnomads.com"
  }
  // Secrets (set in the dashboard, never here): STRIPE_SECRET_KEY,
  // STRIPE_WEBHOOK_SECRET, RESEND_API_KEY, ADMIN_EMAILS, CRON_SECRET,
  // MMK_API_TOKEN, NAUSYS_USERNAME, NAUSYS_PASSWORD. See docs/setup.md.
}
