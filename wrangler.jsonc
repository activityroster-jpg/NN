{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nn",
  // Custom entry: OpenNext's fetch handler plus the scheduled handler (worker.js).
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Hourly: expire 24-hour holds, send balance reminders, refresh FX rates.
  "triggers": { "crons": ["7 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nautical-nomads",
      // Cloudflare dashboard → Storage & Databases → D1 → Create, location
      // Western Europe, name "nautical-nomads" → paste its Database ID here.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true },
  "vars": {
    "SITE_URL": "https://nauticalnomads.com"
  }
  // Secrets (set in the dashboard, never here): STRIPE_SECRET_KEY,
  // STRIPE_WEBHOOK_SECRET, RESEND_API_KEY, ADMIN_EMAILS, CRON_SECRET,
  // MMK_API_TOKEN, NAUSYS_USERNAME, NAUSYS_PASSWORD. See docs/setup.md.
}
